# ClaimForge environment file.
# Copy to .env and export the variables yourself. The package does not load this file.
# Never commit real secrets.

# The HTTP API (`claimforge serve`, `uvicorn claimforge.api:app`) reads the
# same variables. POST /verify uses the OpenAlex mailto, the Semantic Scholar
# key, the embedding model, and the LLM judge gate. POST /judge uses the LLM
# gate only. POST /eval ignores CLAIMFORGE_LLM_* and does not retrieve.
# GET /health reads nothing.

# Optional contact address for the OpenAlex polite pool.
# Not a secret. Leave unset to use the public pool (no API key required).
# CLAIMFORGE_OPENALEX_MAILTO=

# Optional LLM claim extraction and judging. If CLAIMFORGE_LLM_API_KEY or
# CLAIMFORGE_LLM_MODEL is unset, extract-claims stays on the rule extractor and
# verify/judge stay on the rubric. Neither path calls a model.
# PROVIDER: openai-compatible chat completions. Use "rules" to force the rule path.
# BASE_URL defaults to https://api.openai.com/v1 when unset.
# Do not put a real key in git.
# CLAIMFORGE_LLM_PROVIDER=
# CLAIMFORGE_LLM_MODEL=
# CLAIMFORGE_LLM_API_KEY=
# CLAIMFORGE_LLM_BASE_URL=

# Optional Semantic Scholar Graph API key. Retrieval does not need it.
# Unauthenticated calls are the default. HTTP 401 and 429 are skipped.
# CI must not depend on this variable. Do not commit a real key.
# CLAIMFORGE_S2_API_KEY=

# Optional local embedding model for evidence ranking.
# Used only when sentence-transformers is installed (pip install -e ".[embeddings]")
# and --ranker is auto or embeddings. Default is all-MiniLM-L6-v2.
# Not a secret. CI does not install the extra and ranks with TF-IDF instead.
# CLAIMFORGE_EMBEDDING_MODEL=all-MiniLM-L6-v2
