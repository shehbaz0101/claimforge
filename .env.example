# ClaimForge environment file.
# Copy to .env and export the variables yourself. The package does not load this file.
# Never commit real secrets.

# Optional contact address for the OpenAlex polite pool.
# Not a secret. Leave unset to use the public pool (no API key required).
# CLAIMFORGE_OPENALEX_MAILTO=

# Optional LLM claim extraction. If CLAIMFORGE_LLM_API_KEY or CLAIMFORGE_LLM_MODEL
# is unset, extract-claims uses the rule-based extractor and does not call a model.
# PROVIDER: openai-compatible chat completions. Use "rules" to force the rule path.
# BASE_URL defaults to https://api.openai.com/v1 when unset.
# Do not put a real key in git.
# CLAIMFORGE_LLM_PROVIDER=
# CLAIMFORGE_LLM_MODEL=
# CLAIMFORGE_LLM_API_KEY=
# CLAIMFORGE_LLM_BASE_URL=
